{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "TextBlock",
            "text": "📍 ${formatted_address}",
            "weight": "Bolder",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "${addressComponent.district} ${addressComponent.township}",
            "isSubtle": true,
            "wrap": true,
            "spacing": "Small"
        }
    ]
}
